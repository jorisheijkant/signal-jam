# ===================
# Database
# ===================

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host:5432/database

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Neon
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/database?sslmode=require

# Railway
# DATABASE_URL=postgresql://postgres:password@host.railway.app:5432/railway

# ===================
# Authentication
# ===================

# Supabase Auth (if using Supabase)
# Uses SUPABASE_URL and SUPABASE_ANON_KEY from above

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# Clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ===================
# Script Deployment
# ===================

# Path to a Firefox profile that is already logged into X/Twitter.
# Required for cloud deployment (Railway, Render, Fly.io).
# On cloud, point this to the profile directory on a persistent volume.
# Leave unset for local runs — the script will detect your local Firefox profile automatically.
FIREFOX_PROFILE_PATH=

# Railway (uses DATABASE_URL from above)

# Render
RENDER_API_KEY=

# Fly.io
FLY_API_TOKEN=

# ===================
# Dashboard Deployment
# ===================

# Netlify
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# Vercel
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Cloudflare Pages
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ===================
# LLM
# ===================

# Provider for weekly summaries (summarize_weeks.py): 'anthropic', 'openai', or 'ollama'
LLM_PROVIDER=anthropic

# Provider for per-tweet language detection (scrape_x.py): 'anthropic', 'openai', or 'ollama'.
# Defaults to 'ollama' — a lightweight local classification task, no need to burn paid API calls.
LANGUAGE_DETECTION_PROVIDER=ollama

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Ollama (local, no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# Max characters kept from each EUvsDisinfo MCP tool result during AI fact-checking
# (fact_check_with_claude.py), to stop full article text from bloating token usage.
MAX_EUVSDISINFO_OUTPUT_CHARS=1500

# ===================
# Social Media APIs
# ===================

TWITTER_BEARER_TOKEN=
TIKTOK_API_KEY=
FACEBOOK_ACCESS_TOKEN=
