# App identity — used for page titles, meta description, and Open Graph tags
VITE_APP_TITLE=Signal Jam
VITE_APP_DESCRIPTION=Monitoring misinformation on social media.
VITE_APP_URL=https://your-domain.com
VITE_APP_OG_IMAGE=https://your-domain.com/og-image.png

# Auth provider (supabase, auth0, clerk)
VITE_AUTH_PROVIDER=supabase

# Database provider (supabase, postgrest)
VITE_DB_PROVIDER=supabase

# Supabase (client-side)
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# PostgREST — only needed when VITE_DB_PROVIDER=postgrest
# Use this for Neon, Railway, or any self-hosted PostgreSQL (run PostgREST in front of the DB)
# See: https://postgrest.org/en/stable/tutorials/tut0.html
VITE_POSTGREST_URL=http://localhost:3000
VITE_POSTGREST_ANON_KEY=

# Auth redirect URL (where the magic link sends users back to)
# Use http://localhost:5173 for local development
VITE_AUTH_REDIRECT_URL=http://localhost:5173

# Auth0 — only needed when VITE_AUTH_PROVIDER=auth0
# Get these from your Auth0 application settings: https://manage.auth0.com/
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id

# Clerk — only needed when VITE_AUTH_PROVIDER=clerk
# Get this from your Clerk dashboard: https://dashboard.clerk.com/
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Keycloak — only needed when VITE_AUTH_PROVIDER=keycloak
# Self-host Keycloak: https://www.keycloak.org/
VITE_KEYCLOAK_URL=https://keycloak.example.com
VITE_KEYCLOAK_REALM=your-realm
VITE_KEYCLOAK_CLIENT_ID=your-client-id
